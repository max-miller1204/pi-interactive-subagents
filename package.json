{
  "name": "pi-interactive-subagents",
  "version": "4.0.0",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "agents",
    "scripts/patch-pi-declarations.mjs",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@types/node": "24.13.6",
    "node-pty": "1.2.0-beta.14",
    "typebox": "1.3.27",
    "typescript": "7.0.2"
  },
  "scripts": {
    "postinstall": "node scripts/patch-pi-declarations.mjs",
    "typecheck": "tsc",
    "lint": "biome check --error-on-warnings .",
    "test:unit": "node --test test/unit/*.test.ts",
    "test:sdk": "node --test test/sdk/*.test.ts",
    "test:e2e": "node scripts/run-tests.mjs --isolated-tmux --test --test-concurrency=1 test/e2e/*.test.ts",
    "test:docker": "docker build -f test/evidence/Dockerfile -t pi-subagents-evidence . && docker run --rm --init --network none pi-subagents-evidence",
    "test:record": "node scripts/run-tests.mjs --isolated-tmux --test test/evidence/record.test.ts",
    "check:pi-version": "node scripts/check-pi-version.mjs",
    "test": "npm run check:pi-version && npm run typecheck && npm run lint && npm run test:unit && npm run test:sdk"
  },
  "allowScripts": {
    "node-pty@1.2.0-beta.14": true
  }
}
